# Copie este arquivo para server/.env. Nunca versione o arquivo .env real.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_nova_chave_secreta_aqui
ANTHROPIC_API_KEY=cole_a_chave_da_anthropic_aqui
# Needed only when the Anthropic key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Stripe: use sk_test_ durante os testes e sk_live_ somente depois da validação.
# Os preços precisam ser recorrentes mensais (Price IDs iniciam com price_).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
ZOOMDEV_URL=http://localhost:5173
# E-mail transacional via Resend. O domínio do remetente deve estar verificado
# na conta Resend; não exponha esta chave no frontend.
RESEND_API_KEY=re_...
EMAIL_REMETENTE=ZoomDev OS <contato@seudominio.com>
